rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ✅ Rules for meta (orderCounter, etc.)
    match /meta/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // User subcollections (petData, preferences, etc.)
      match /{subcollection}/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Hawker listings
    match /hawkerListings/{hawkerId} {
      allow read: if true; // Anyone can read hawker listings
      allow create: if request.auth != null;
      // Allow owner to write/delete
      allow write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow authenticated users to update ONLY favouritedUser OR reviews (NO OTHER CHECKS)
      allow update: if request.auth != null && 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favouritedUser']) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews']));
    }
    
    // Item listings
    match /itemListings/{itemId} {
      allow read: if true; // Anyone can read items
      allow write: if request.auth != null;
    }
    
    // Orders collection - Allow querying by orderID
      match /orders/{orderId} {
        // Allow any authenticated user to query orders (they can only see their own via client-side filtering)
        allow list: if request.auth != null;
        // Allow reading specific document if user is buyer or hawker
        allow get: if request.auth != null && 
                  (request.auth.uid == resource.data.buyerId || 
                  request.auth.uid == resource.data.userId || 
                  request.auth.uid == resource.data.hawkerId);
        allow create: if request.auth != null;
        allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.buyerId || 
                      request.auth.uid == resource.data.userId || 
                      request.auth.uid == resource.data.hawkerId);
      }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Anyone can read reviews
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.reviewerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }
    
    // Cart collection
    match /cart/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Support Requests collection
    match /supportRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
    }
    
    // User's support tickets subcollection
    match /users/{userId}/supportTickets/{ticketId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
  }
}