    padding-right: 1rem !important;
  }
  
  /* Remove margins that cause issues */
  .hawker-analytics {
    margin: 0 !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }
  
  /* Fix text colors in charts for print */
  canvas {
